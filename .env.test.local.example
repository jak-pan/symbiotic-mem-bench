# Local test env example for membench.
#
# This file mirrors `.env.example`. The runtime default looks for
# `.env.test.local` in this benchmark repository.
#
#   cp .env.test.local.example .env.test.local
#
# Keep real keys only in `.env.test.local`; it is gitignored.
#
# Naming contract (docs/environment.md): MEMBENCH_* = harness vars;
# SYMBIOTIC_MEMORY__SECTION__FIELD = engine config overrides
# (knob reference: ../symbiotic-memory/docs/RUNBOOK.md). SYMEM_* is dead.

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Only needed for explicit --embedder gemini comparison arms.
GEMINI_API_KEY=
# Optional experimental provider keys.
# NVIDIA_API_KEY=
# CERBERAS_API_KEY=

# Model defaults live in symbiotic-memory code/config and the harness CLI defaults
# (--embedder openrouter → qwen/qwen3-embedding-8b @ 1024 dims). Leave these unset
# unless the experiment intentionally changes a model or provider.
# MEMBENCH_DISTILL_OPERATOR=deepseek
# MEMBENCH_DISTILL_BASE_URL=https://api.deepseek.com
# MEMBENCH_DISTILL_MODEL=deepseek-v4-flash
# MEMBENCH_ANSWER_OPERATOR=deepseek
# MEMBENCH_ANSWER_BASE_URL=https://api.deepseek.com
# MEMBENCH_ANSWER_MODEL=deepseek-v4-pro
# MEMBENCH_EMBED_OPERATOR=openrouter
# MEMBENCH_EMBED_MODEL=qwen/qwen3-embedding-8b
# MEMBENCH_EMBED_DIMS=1024

# Benchmark judge overrides are separate from memory defaults.
# MEMBENCH_JUDGE_OPERATOR=deepseek
# MEMBENCH_JUDGE_BASE_URL=https://api.deepseek.com
# MEMBENCH_JUDGE_MODEL=deepseek-v4-flash
# MEMBENCH_JUDGE_PROMPT_MODE=official   # default; `semantic` = legacy generic grader
# MEMBENCH_JUDGE_THINKING=disabled
# MEMBENCH_JUDGE_MAX_TOKENS=64

# Cross-encoder reranker: ON by default (free Nemotron). MEMBENCH_RERANK=0 disables.
# MEMBENCH_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

# Embedding request packing (engine [embed] config; Gemini-arm safe values).
SYMBIOTIC_MEMORY__EMBED__BATCH_SIZE=16
SYMBIOTIC_MEMORY__EMBED__BATCH_CONCURRENCY=16
SYMBIOTIC_MEMORY__EMBED__BATCH_MAX_CHARS=12000
# Enabled by default in symbiotic-memory so embedding traces can be priced.
# SYMBIOTIC_MEMORY__EMBED__GEMINI_COUNT_TOKENS=true
# SYMBIOTIC_MEMORY__EMBED__GEMINI_COUNT_TOKENS_MODEL=gemini-embedding-2

MEMBENCH_TRACE_JSONL=1
MEMBENCH_QUEUE_TRACE_JSONL=1
MEMBENCH_QUESTION_TIMEOUT_SECS=0
SYMBIOTIC_MEMORY__DISTILL__WINDOW_TIMEOUT_SECS=0
SYMBIOTIC_MEMORY__DISTILL__TURNS_PER_WINDOW=16
SYMBIOTIC_MEMORY__DISTILL__PARSE_RETRIES=4

SYMBIOTIC_MEMORY__TRANSPORT__CHAT_TIMEOUT_SECS=240
SYMBIOTIC_MEMORY__EMBED__TIMEOUT_SECS=120
SYMBIOTIC_MEMORY__TRANSPORT__CONNECT_TIMEOUT_SECS=30
SYMBIOTIC_MEMORY__TRANSPORT__POOL_IDLE_SECS=90
SYMBIOTIC_MEMORY__TRANSPORT__POOL_MAX_IDLE_PER_HOST=128

# Leave queue and cache overrides unset unless intentionally testing them.
# Per-model queue tuning belongs in the memory YAML profile
# (queue.models."operation:operator:model"); the old SYMEM_QUEUE_<ID>_* env
# overrides are gone.
# MEMBENCH_WORKFLOW_MAX_IN_FLIGHT=50
# MEMBENCH_RESPONSE_CACHE_DIR=
