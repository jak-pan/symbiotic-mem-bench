# Membench local environment template.
#
# Copy this file to `.env.test.local` in this repository for normal local runs:
#
#   cp .env.example .env.test.local
#
# `membench` loads this repository's `.env.test.local` by default. Do not commit
# real `.env` files. Use `--env-file path/to/file` only when intentionally
# testing an alternate environment.
#
# Naming contract (see docs/environment.md):
#   MEMBENCH_*                        benchmark-harness vars (roles/models, judge, rerank,
#                                     workflow, trace/cache plumbing, experiment helpers)
#   SYMBIOTIC_MEMORY__SECTION__FIELD  engine config overrides, mapped mechanically onto the
#                                     kit's typed config (embed.batch_size, distill.*, ...);
#                                     knob reference: ../symbiotic-memory/docs/RUNBOOK.md
# The old SYMEM_* prefix is dead.

# Required for paid runs on the owner-default stack.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Only needed for explicit --embedder gemini comparison arms.
GEMINI_API_KEY=
# Optional providers used by experimental arms only.
# NVIDIA_API_KEY=
# CERBERAS_API_KEY=

# Model defaults live in symbiotic-memory code/config and the harness CLI defaults
# (--embedder openrouter → qwen/qwen3-embedding-8b @ 1024 dims). Leave role overrides
# unset unless the experiment intentionally changes a model or provider.
# Role pattern: MEMBENCH_<ROLE>_{OPERATOR,BASE_URL,MODEL,QUEUE_ID,MAX_TOKENS,THINKING,REASONING_EFFORT}
# for the DISTILL / ANSWER / EMBED / JUDGE / CONSOLIDATE / RERANK roles.
# MEMBENCH_DISTILL_OPERATOR=deepseek
# MEMBENCH_DISTILL_BASE_URL=https://api.deepseek.com
# MEMBENCH_DISTILL_MODEL=deepseek-v4-flash
# MEMBENCH_ANSWER_OPERATOR=deepseek
# MEMBENCH_ANSWER_BASE_URL=https://api.deepseek.com
# MEMBENCH_ANSWER_MODEL=deepseek-v4-pro
# MEMBENCH_EMBED_OPERATOR=openrouter
# MEMBENCH_EMBED_MODEL=qwen/qwen3-embedding-8b
# MEMBENCH_EMBED_DIMS=1024
# MEMBENCH_EMBED_REQUEST_DIMS=1024
# Gemini comparison arm:
# MEMBENCH_EMBED_OPERATOR=gemini
# MEMBENCH_EMBED_MODEL=gemini-embedding-2
# MEMBENCH_EMBED_DIMS=3072

# Benchmark judge overrides are separate from memory defaults (harness-owned;
# defaults: deepseek-v4-flash, thinking disabled, 64 output tokens).
# MEMBENCH_JUDGE_OPERATOR=deepseek
# MEMBENCH_JUDGE_BASE_URL=https://api.deepseek.com
# MEMBENCH_JUDGE_MODEL=deepseek-v4-flash
# MEMBENCH_JUDGE_PROMPT_MODE=official   # default; `semantic` = legacy generic grader
# MEMBENCH_JUDGE_THINKING=disabled
# MEMBENCH_JUDGE_MAX_TOKENS=64

# Cross-encoder reranker (harness-owned). ON by default with the free Nemotron model.
# MEMBENCH_RERANK=0
# MEMBENCH_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# MEMBENCH_RERANK_STAGE1_MODEL=            # optional cheap stage-1 prefilter
# MEMBENCH_RERANK_STAGE1_TOP_X=20
# Engine-side rerank tuning goes through config keys, e.g.:
# SYMBIOTIC_MEMORY__RECALL__RERANK_CANDIDATES=100

# Reference clock passed to Symbiotic Memory's query planner and answerer.
# Leave unset for normal runs: membench supplies the current RFC3339 timestamp
# with timezone. Set only for a benchmark that intentionally pins a clock.
# MEMBENCH_REFERENCE_DATETIME=2026-06-19T15:15:42+08:00

# Embedding request packing (engine [embed] config section). The Gemini arm keeps
# batch size 16 / 12000 chars unless a measured run says otherwise.
SYMBIOTIC_MEMORY__EMBED__BATCH_SIZE=16
SYMBIOTIC_MEMORY__EMBED__BATCH_CONCURRENCY=16
SYMBIOTIC_MEMORY__EMBED__BATCH_MAX_CHARS=12000
# Per-input local text cap (harness-owned adapter parameter, not packing):
# MEMBENCH_EMBED_MAX_CHARS=32000
# Gemini transport mode; multi-input request mode is the default behavior.
# SYMBIOTIC_MEMORY__EMBED__GEMINI_TRANSPORT=multi-input-request
# Enabled by default in symbiotic-memory so embedding traces can be priced.
# SYMBIOTIC_MEMORY__EMBED__GEMINI_COUNT_TOKENS=true
# SYMBIOTIC_MEMORY__EMBED__GEMINI_COUNT_TOKENS_MODEL=gemini-embedding-2

# Trace output. `membench` writes queue/model traces under each run root.
MEMBENCH_TRACE_JSONL=1
MEMBENCH_QUEUE_TRACE_JSONL=1
# SYMBIOTIC_MEMORY__TRANSPORT__PROVIDER_TRACE=true
# SYMBIOTIC_MEMORY__DISTILL__INGEST_TRACE=true
# SYMBIOTIC_MEMORY__DISTILL__TRACE=true

# Outer workflow guards. Keep source/window guards disabled for queued provider
# runs because model-call timeouts and queue leases are the real controls.
MEMBENCH_QUESTION_TIMEOUT_SECS=0
SYMBIOTIC_MEMORY__DISTILL__WINDOW_TIMEOUT_SECS=0
SYMBIOTIC_MEMORY__DISTILL__TURNS_PER_WINDOW=16
SYMBIOTIC_MEMORY__DISTILL__PARSE_RETRIES=4

# HTTP/client timeouts and pooling (engine [transport]/[embed] config sections;
# 0-valued pool fields keep the engine's per-target tuned defaults).
SYMBIOTIC_MEMORY__TRANSPORT__CHAT_TIMEOUT_SECS=240
SYMBIOTIC_MEMORY__EMBED__TIMEOUT_SECS=120
SYMBIOTIC_MEMORY__TRANSPORT__CONNECT_TIMEOUT_SECS=30
SYMBIOTIC_MEMORY__TRANSPORT__POOL_IDLE_SECS=90
SYMBIOTIC_MEMORY__TRANSPORT__POOL_MAX_IDLE_PER_HOST=128
# SYMBIOTIC_MEMORY__TRANSPORT__HTTP1_ONLY=true
# SYMBIOTIC_MEMORY__TRANSPORT__OPENROUTER_CLIENT_POOL_SIZE=128
# SYMBIOTIC_MEMORY__TRANSPORT__CHAT_CLIENT_POOL_SIZE=0

# Workflow queue overrides. Leave unset to use the selected memory YAML profile.
# MEMBENCH_WORKFLOW_MAX_IN_FLIGHT=50
# MEMBENCH_WORKFLOW_MAX_ATTEMPTS=3
# MEMBENCH_WORKFLOW_RETRY_DELAY_SECS=5

# Exact per-model queue tuning lives in the memory YAML profile
# (queue.models."operation:operator:model"), not in env. The old
# SYMEM_QUEUE_<ID>_* env overrides are gone.

# Response cache roots. Leave unset for per-run local cache; set only when
# intentionally sharing successful provider responses across compatible runs.
# MEMBENCH_RESPONSE_CACHE_DIR=

# Optional local E2E compatibility flags from the Symbiotic workspace.
# SYMBIOTIC_E2E_PROVIDER=
# SYMBIOTIC_E2E_MODEL=
# SYMBIOTIC_E2E_REAL_KEYS=0
