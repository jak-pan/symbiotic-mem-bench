# Membench local environment template.
#
# Copy this file to `.env.test.local` in this repository for normal local runs:
#
#   cp .env.example .env.test.local
#
# `membench` loads this repository's `.env.test.local` by default. Do not commit
# real `.env` files. Use `--env-file path/to/file` only when intentionally
# testing an alternate environment.

# Required for paid Symbiotic Memory runs.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional providers used by experimental arms only.
# NVIDIA_API_KEY=
# CERBERAS_API_KEY=

# Role/model defaults. These match the current LongMemEval raw-light profile.
SYMEM_DISTILL_OPERATOR=deepseek
SYMEM_DISTILL_BASE_URL=https://api.deepseek.com
SYMEM_DISTILL_MODEL=deepseek-v4-flash

SYMEM_ANSWER_OPERATOR=deepseek
SYMEM_ANSWER_BASE_URL=https://api.deepseek.com
SYMEM_ANSWER_MODEL=deepseek-v4-pro

SYMEM_QUERY_PLANNER_OPERATOR=deepseek
SYMEM_QUERY_PLANNER_BASE_URL=https://api.deepseek.com
SYMEM_QUERY_PLANNER_MODEL=deepseek-v4-flash

SYMEM_TEMPORAL_ANSWER_OPERATOR=deepseek
SYMEM_TEMPORAL_ANSWER_BASE_URL=https://api.deepseek.com
SYMEM_TEMPORAL_ANSWER_MODEL=deepseek-v4-pro

SYMEM_JUDGE_OPERATOR=deepseek
SYMEM_JUDGE_BASE_URL=https://api.deepseek.com
SYMEM_JUDGE_MODEL=deepseek-v4-flash
SYMEM_JUDGE_PROMPT_MODE=semantic-shared-compact
SYMEM_JUDGE_THINKING=disabled
SYMEM_JUDGE_MAX_TOKENS=64

SYMEM_EMBED_MODEL=gemini-embedding-2
SYMEM_EMBED_DIMS=3072

# Gemini embedding transport. Default is multi-input request mode, not the
# offline asynchronous batch API. Keep batch size 16 unless a measured run says
# otherwise.
SYMEM_GEMINI_EMBED_MODE=multi-input
SYMEM_EMBED_BATCH_SIZE=16
SYMEM_EMBED_BATCH_CONCURRENCY=16
SYMEM_EMBED_BATCH_MAX_CHARS=12000

# Trace output. `membench` writes queue/model traces under each run root.
SYMEM_TRACE_JSONL=1
SYMEM_QUEUE_TRACE_JSONL=1
# SYMEM_PROVIDER_TRACE=1
# SYMEM_INGEST_TRACE=1
# SYMEM_DISTILL_TRACE=1

# Outer workflow guards. Keep source/window guards disabled for queued provider
# runs because model-call timeouts and queue leases are the real controls.
SYMEM_QUESTION_TIMEOUT_SECS=0
SYMEM_DISTILL_WINDOW_TIMEOUT_SECS=0
SYMEM_DISTILL_TURNS_PER_WINDOW=16
SYMEM_DISTILL_PARSE_RETRIES=4

# HTTP/client timeouts and pooling.
SYMEM_HTTP_TIMEOUT_SECS=240
SYMEM_EMBED_TIMEOUT_SECS=120
SYMEM_HTTP_CONNECT_TIMEOUT_SECS=30
SYMEM_HTTP_POOL_IDLE_SECS=90
SYMEM_HTTP_POOL_MAX_IDLE_PER_HOST=128
SYMEM_GEMINI_HTTP_POOL_MAX_IDLE_PER_HOST=128

# Workflow queue overrides. Leave unset to use the selected memory YAML profile.
# SYMEM_WORKFLOW_MAX_IN_FLIGHT=50
# SYMEM_WORKFLOW_MAX_ATTEMPTS=3
# SYMEM_WORKFLOW_RETRY_DELAY_SECS=5

# Exact queue overrides. Queue ids are sanitized by uppercasing and replacing
# non-alphanumeric characters with `_`.
# SYMEM_QUEUE_CHAT_DEEPSEEK_DEEPSEEK_V4_FLASH_MAX_IN_FLIGHT=400
# SYMEM_QUEUE_CHAT_DEEPSEEK_DEEPSEEK_V4_PRO_MAX_IN_FLIGHT=400
# SYMEM_QUEUE_EMBEDDING_GEMINI_GEMINI_EMBEDDING_2_MAX_IN_FLIGHT=400

# Response cache roots. Leave unset for per-run local cache; set only when
# intentionally sharing successful provider responses across compatible runs.
# SYMEM_RESPONSE_CACHE_DIR=
# SYMEM_DISTILL_RESPONSE_CACHE_DIR=
# SYMEM_ANSWER_RESPONSE_CACHE_DIR=
# SYMEM_EMBED_RESPONSE_CACHE_DIR=

# Optional local E2E compatibility flags from the Symbiotic workspace.
# SYMBIOTIC_E2E_PROVIDER=
# SYMBIOTIC_E2E_MODEL=
# SYMBIOTIC_E2E_REAL_KEYS=0
