      {
        "_missionControl": {
          "owner": "mission-control",
          "version": "2.2.0"
        },
        "hooks": [
          {
            "type": "command",
            "command": "MC_ENROLLMENT_TOOL=claude-code node \"$CLAUDE_PROJECT_DIR/.mission-control/lifecycle-hook.mjs\"",
